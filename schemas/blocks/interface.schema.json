{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuji-bonji.github.io/mutualspec/schemas/0.1/blocks/interface.schema.json",
  "title": "mutualspec:interface — 公開言語（Published Language）/ Open Host Service",
  "type": "object",
  "required": ["interfaces"],
  "properties": {
    "interfaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "provider", "style", "operations"],
        "properties": {
          "id": { "type": "string", "pattern": "^IFC-[A-Z][A-Z0-9]{1,7}-[A-Z0-9-]+$" },
          "provider": { "$ref": "../common.schema.json#/$defs/contextCode" },
          "style": { "enum": ["open-host-service", "published-language", "event-stream", "document"] },
          "publishedTerms": { "$ref": "../common.schema.json#/$defs/refList" },
          "contract": { "type": "string", "description": "外部契約ファイル（OpenAPI / AsyncAPI / JSON Schema）へのパス" },
          "operations": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["name", "kind"],
              "properties": {
                "name": { "type": "string" },
                "kind": { "enum": ["query", "command", "event"] },
                "input": { "type": "array", "items": { "$ref": "model.schema.json#/$defs/attribute" } },
                "output": { "type": "array", "items": { "$ref": "model.schema.json#/$defs/attribute" } },
                "description": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
