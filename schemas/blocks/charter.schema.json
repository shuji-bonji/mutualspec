{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuji-bonji.github.io/mutualspec/schemas/0.1/blocks/charter.schema.json",
  "title": "mutualspec:charter — 境界づけられたコンテキスト（またはプロジェクト）の憲章",
  "type": "object",
  "required": ["charter"],
  "properties": {
    "charter": {
      "type": "object",
      "required": ["context", "name", "purpose", "inScope", "outOfScope"],
      "properties": {
        "context": { "$ref": "../common.schema.json#/$defs/contextCode" },
        "name": { "$ref": "../common.schema.json#/$defs/localizedText" },
        "subdomainType": { "enum": ["core", "supporting", "generic", "project"] },
        "purpose": { "$ref": "../common.schema.json#/$defs/localizedText" },
        "inScope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "outOfScope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "answerableQuestions": {
          "type": "array", "items": { "type": "string" },
          "description": "このコンテキストの仕様で答えられる問い。LLM の回答範囲の宣言に使う。"
        },
        "properties": {
          "type": "array",
          "description": "適用性（applicability）で使える製品・運用プロパティ",
          "items": {
            "type": "object", "required": ["name", "values"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
              "description": { "type": "string" },
              "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } }
            },
            "additionalProperties": false
          }
        },
        "roles": {
          "type": "array",
          "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false }
        },
        "codeModule": { "type": "string", "description": "実装上のモジュール/パッケージ（例: src/contexts/maintenance）" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
